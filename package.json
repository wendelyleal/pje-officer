{
  "name": "pje-officer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "start": "bun run scripts/serve.ts",
    "build": "bun build packages/api/src/index.ts --outfile dist/pje-officer.js --target bun && cd packages/web && bun run build",
    "test": "cd packages/api && bun test",
    "cli": "bun run packages/api/src/index.ts",
    "ui:dev": "cd packages/web && bun run dev",
    "ui:build": "cd packages/web && bun run build",
    "ui:lint": "cd packages/web && bun run lint"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
